<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bkarki.claude-pipeline.dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-l</string>
        <string>-c</string>
        <string>exec /opt/homebrew/bin/python3 /Users/bkarki/.claude-pipeline/bin/api-server.py --port 7778</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/bkarki/.claude-pipeline</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/bkarki</string>
        <key>PATH</key>
        <string>/Users/bkarki/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/bkarki/.claude-pipeline/logs/dashboard-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/bkarki/.claude-pipeline/logs/dashboard-stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
