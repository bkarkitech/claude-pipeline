    echo "  wait_for_subtasks: true|false"
    echo "  machine: hostname|tag|any"
    echo "  requires_approval: true|false"
    echo "  assigned_to: username"
    echo "  schedule: \"0 9 * * 1-5\""
    echo "  ---"
    echo "  # Your task description here"
}

# ─── Main Router ──────────────────────────────────────────────────────────────
command="${1:-help}"
shift 2>/dev/null || true

case "$command" in
    add)      cmd_add "$@" ;;
    new)      cmd_new "$@" ;;
    run)      cmd_run "$@" ;;
    spawn)    cmd_spawn "$@" ;;
    chain)    cmd_chain "$@" ;;
    dispatch) cmd_dispatch ;;
    dashboard) cmd_dashboard "$@" ;;
    costs)    cmd_costs "$@" ;;
    notify-test|notify) cmd_notify_test "$@" ;;
    deps|dependencies) cmd_deps ;;
    schedule|schedules) cmd_schedule "$@" ;;
    status)   cmd_status ;;
    list|ls)  cmd_list "$@" ;;
    view)     cmd_view "$@" ;;
    resume)   cmd_resume "$@" ;;
    retry)    cmd_retry "$@" ;;
    state)    cmd_state "$@" ;;
    logs|log) cmd_logs "$@" ;;
    live)     cmd_live "$@" ;;
    watch)    cmd_watch ;;
    stop)     cmd_stop ;;
    up)       cmd_up ;;
    down)     cmd_down ;;
    install)  cmd_install ;;
    telegram) cmd_telegram "$@" ;;
    plugin)   cmd_plugin "$@" ;;
    approve)  cmd_approve "$@" ;;
    reject)   cmd_reject "$@" ;;
    cluster)  cmd_cluster "$@" ;;
    clean)    cmd_clean "$@" ;;
    help|-h|--help) cmd_help ;;
    *)
        echo -e "${RED}Unknown command:${NC} $command"
        echo "Run 'pipeline help' for usage."
        exit 1
        ;;
esac
